{
  "name": "boca-vestuario",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "El vestuario de Boca en 3D: una remera por jugador del plantel. Tributo no oficial.",
  "scripts": {
    "dev": "next dev --port 4950",
    "build": "next build",
    "start": "next start --port 4950",
    "lint": "eslint",
    "test": "vitest run",
    "gate": "vitest run && eslint && next build",
    "smoke": "node --env-file=.env.local scripts/smoke.mjs",
    "seed": "node --env-file=.env.local scripts/seed.mjs",
    "eval": "python3 scripts/squad_drift.py",
    "data": "python3 scripts/fetch_squad.py",
    "uv:fit": "python3 scripts/uv_fit.py public/models/camiseta.glb",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource/anton": "^5.3.0",
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "@react-three/fiber": "^9.8.2",
    "delaunator": "^5.1.0",
    "firebase": "^13.2.0",
    "firebase-admin": "^14.5.0",
    "gsap": "^3.15.1",
    "next": "^16.3.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/react": "^16.3.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.1",
    "jsdom": "^31.0.0",
    "tailwindcss": "^4.3.5",
    "vitest": "^5.1.0"
  }
}
